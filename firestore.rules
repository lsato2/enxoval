rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }

    // Dados pessoais de cada usuário (qual enxoval ele acessa)
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // O enxoval compartilhado
    match /families/{fid} {
      function isMember() { return signedIn() && request.auth.uid in resource.data.members; }
      function isInvited() {
        return signedIn() && request.auth.token.email != null
          && myEmail() in resource.data.invites;
      }

      // Criar: o criador é o único membro
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];

      // Ler: membros e convidados (o convidado precisa achar o convite)
      allow read: if isMember() || isInvited();

      // Membros podem editar tudo
      allow update: if isMember()
        // Convidado pode apenas se adicionar como membro
        || (isInvited()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberEmails', 'invites'])
            && request.resource.data.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet()));

      allow delete: if isMember();
    }
  }
}
